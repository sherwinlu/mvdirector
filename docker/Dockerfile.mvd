# mvdirector orchestrator + QC + review UI container.
# Includes ffmpeg, MediaPipe (Apache-2.0 face/lip-sync QC), faster-whisper alignment, and Streamlit.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_CONSTRAINT=/app/constraints.txt \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md LICENSE constraints.txt ./
COPY src/ ./src/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir ".[qc,align,ui,anthropic]"

# Pre-fetch the MediaPipe face models so QC needs no network access at run time.
ENV MVD_MEDIAPIPE_CACHE_DIR=/opt/mvdirector/models
RUN python -c "from mvdirector.qc.faces import MediaPipeFaceAnalyzer, MediaPipeMouthTracker; MediaPipeFaceAnalyzer().close(); MediaPipeMouthTracker()"

WORKDIR /workspace

EXPOSE 8501

ENTRYPOINT ["mvd"]
CMD ["--help"]
