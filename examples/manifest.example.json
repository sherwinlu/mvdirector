  "character": {
    "appearance": "A woman of about 30 with medium-deep brown skin, an elongated oval face, high cheekbones, dark almond-shaped eyes under straight brows, and a small beauty mark beneath the outer corner of her LEFT eye. Jet-black blunt jaw-length bob with a center part, ends curved inward. Tall, lean, athletic build. Satin skin, extended black winged liner, deep rose-brown lipstick.",
    "wardrobe": [
      {
        "id": "cape",
        "description": "Fitted black structured bodysuit with a high square neckline, brushed-silver shoulder caps and forearm cuffs, a floor-length black cape with an oxblood lining clasped at the collarbone, pointed black ankle boots."
      },
      {
        "id": "bare",
        "description": "The same black bodysuit, silver shoulder caps, cuffs and boots. No cape: the collarbone clasps are open and nothing hangs from the shoulders."
      }
