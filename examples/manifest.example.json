  "visual_bible": {
    "concept": "A self-crowned club knight turns the architecture of confinement into her own stage.",
    "style": "glossy editorial club-pop, architectural fashion film, polished metal against matte fabric",
    "palette": "obsidian black, brushed silver, electric cobalt, saturated oxblood",
    "lighting": "large soft neutral face key, hard cobalt side light, narrow white rim light",
    "negative_prompt": "changing hairstyle, knight helmet, face-covering visor, gold armor, watermarks",
    "settings": [
      {
        "name": "The Blade Corridor",
        "sections": [
          "Intro",
          "Verse"
        ],
        "description": "A long, narrow passage of matte-black panels with vertical silver strips and thin cobalt light seams; a white floor line leads toward the lens.",
        "movement": "She walks toward a retreating camera, placing each heel on the beat. Mostly waist-up.",
        "plate": "assets/plates/blade_corridor.png"
      },
      {
        "name": "The Knight Floor",
        "sections": [
          "Chorus",
          "Post-Chorus"
        ],
        "description": "A black stage with oversized alternating matte-black and charcoal floor squares, silver perimeter rails and a suspended lighting grid.",
        "movement": "Two decisive steps, a quarter-turn and an angular arm frame.",
        "plate": "assets/plates/knight_floor.png"
      },
      {
        "name": "The Quiet Chamber",
        "sections": [
          "Bridge"
        ],
        "description": "A small, nearly empty charcoal room with a dark oxblood rear wall, a narrow steel bench and one vertical opening of warm white light.",
        "movement": "She begins seated, then stands, and lifts her chin to meet the lens.",
        "plate": "assets/plates/quiet_chamber.png"
      }
    ],
    "rules": [
      "Keep the singer visibly performing for most of the video; cutaways belong to her body or costume.",
      "Eye-level medium shots and close-ups are the foundation; camera moves are smooth and on one axis.",
      "Armor stays brushed silver, never chrome or gold.",
      "The cape comes off in the bridge and never reappears.",
      "Never duplicate or smear her face during a sung line."
    ]
  },
