{
  "$defs": {
    "LyricLine": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "timing_source": {
          "default": "none",
          "enum": [
            "aligned",
            "estimated",
            "none"
          ],
          "title": "Timing Source",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "LyricLine",
      "type": "object"
    },
    "TimeSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeSpan",
      "type": "object"
    },
    "TrackProfile": {
      "additionalProperties": false,
      "description": "Detected musical, vocal, and linguistic characteristics used to auto-tune parameters.",
      "properties": {
        "languages": {
          "description": "Detected ISO-639-1/639-2 language codes (e.g. ['en'], ['fr', 'en'], ['zh']).",
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "multilingual": {
          "default": false,
          "description": "True when lyrics or style cues span more than one language.",
          "title": "Multilingual",
          "type": "boolean"
        },
        "vocal_mode": {
          "default": "solo",
          "description": "Primary vocal arrangement ('solo', 'duet', 'group', or 'instrumental').",
          "enum": [
            "solo",
            "duet",
            "group",
            "instrumental"
          ],
          "title": "Vocal Mode",
          "type": "string"
        },
        "rap_or_fast_vocal": {
          "default": false,
          "description": "True when style cues or measured syllable rate indicate rap or rapid phrasing.",
          "title": "Rap Or Fast Vocal",
          "type": "boolean"
        },
        "drop_or_chop_heavy": {
          "default": false,
          "description": "True when style/section cues or peak non-lyric bars indicate drops/vocal chops.",
          "title": "Drop Or Chop Heavy",
          "type": "boolean"
        },
        "extreme_vocals": {
          "default": false,
          "description": "True when cues indicate screamed, whispered, or heavily processed vocals.",
          "title": "Extreme Vocals",
          "type": "boolean"
        },
        "non_4_4_or_free_time": {
          "default": false,
          "description": "True when cues indicate 3/4, 6/8, odd meter, or rubato/beatless timing.",
          "title": "Non 4 4 Or Free Time",
          "type": "boolean"
        },
        "beats_per_bar_hint": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Meter grouping inferred from style cues when explicitly non-4/4 (e.g. 3).",
          "title": "Beats Per Bar Hint"
        },
        "syllables_per_second": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Measured sung syllable/token rate across aligned or active vocal spans.",
          "title": "Syllables Per Second"
        },
        "intensity_contrast": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "90th-minus-20th percentile of bar_intensity (0-1).",
          "title": "Intensity Contrast"
        },
        "reasons": {
          "description": "Human-readable explanations for detected track characteristics.",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "title": "TrackProfile",
      "type": "object"
    },
    "VocalTurn": {
      "additionalProperties": false,
      "description": "A contiguous vocal phrase attributed to one acoustic voice cluster or simultaneous duet.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "voice": {
          "description": "Acoustic voice id ('voice_1', 'voice_2', ordered low-to-high pitch, or 'both' when multiple voices sing simultaneously).",
          "title": "Voice",
          "type": "string"
        },
        "median_f0_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Median fundamental frequency in Hz across voiced frames.",
          "title": "Median F0 Hz"
        }
      },
      "required": [
        "start",
        "end",
        "voice"
      ],
      "title": "VocalTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "duration": {
      "title": "Duration",
      "type": "number"
    },
    "tempo_bpm": {
      "title": "Tempo Bpm",
      "type": "number"
    },
    "beats": {
      "items": {
        "type": "number"
      },
      "title": "Beats",
      "type": "array"
    },
    "bars": {
      "description": "Start time of each bar, in seconds.",
      "items": {
        "type": "number"
      },
      "title": "Bars",
      "type": "array"
    },
    "bar_intensity": {
      "description": "Loudness of each bar, scaled 0-1.",
      "items": {
        "type": "number"
      },
      "title": "Bar Intensity",
      "type": "array"
    },
    "vocal_windows": {
      "items": {
        "$ref": "#/$defs/TimeSpan"
      },
      "title": "Vocal Windows",
      "type": "array"
    },
    "vocal_turns": {
      "description": "Diarized vocal turns grouped by acoustic voice pitch and timbre.",
      "items": {
        "$ref": "#/$defs/VocalTurn"
      },
      "title": "Vocal Turns",
      "type": "array"
    },
    "lyric_lines": {
      "items": {
        "$ref": "#/$defs/LyricLine"
      },
      "title": "Lyric Lines",
      "type": "array"
    },
    "track_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrackProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Detected musical/vocal/language profile used for automatic parameter tuning."
    }
  },
  "required": [
    "duration",
    "tempo_bpm",
    "beats",
    "bars",
    "bar_intensity",
    "vocal_windows"
  ],
  "title": "Analysis",
  "type": "object"
}
