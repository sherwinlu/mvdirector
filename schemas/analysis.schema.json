{
  "$defs": {
    "AnalyzedChapter": {
      "additionalProperties": false,
      "description": "Per-track or fixed-interval segment measured during long-form mix audio analysis.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "bpm": {
          "exclusiveMinimum": 0.0,
          "title": "Bpm",
          "type": "number"
        },
        "downbeat_offset": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Downbeat Offset",
          "type": "number"
        },
        "energy": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Energy",
          "type": "number"
        },
        "mood_tags": {
          "items": {
            "type": "string"
          },
          "title": "Mood Tags",
          "type": "array"
        },
        "genre_tags": {
          "items": {
            "type": "string"
          },
          "title": "Genre Tags",
          "type": "array"
        },
        "theme_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theme Prompt"
        },
        "clip_prompts": {
          "items": {
            "type": "string"
          },
          "title": "Clip Prompts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "index",
        "start",
        "end",
        "title",
        "bpm"
      ],
      "title": "AnalyzedChapter",
      "type": "object"
    },
    "LyricLine": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "timing_source": {
          "default": "none",
          "enum": [
            "aligned",
            "estimated",
            "none"
          ],
          "title": "Timing Source",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "LyricLine",
      "type": "object"
    },
    "TimeSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeSpan",
      "type": "object"
    },
    "VocalTurn": {
      "additionalProperties": false,
      "description": "A contiguous vocal phrase attributed to one acoustic voice cluster or simultaneous duet.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "voice": {
          "description": "Acoustic voice id ('voice_1', 'voice_2', ordered low-to-high pitch, or 'both' when multiple voices sing simultaneously).",
          "title": "Voice",
          "type": "string"
        },
        "median_f0_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Median fundamental frequency in Hz across voiced frames.",
          "title": "Median F0 Hz"
        }
      },
      "required": [
        "start",
        "end",
        "voice"
      ],
      "title": "VocalTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "duration": {
      "title": "Duration",
      "type": "number"
    },
    "tempo_bpm": {
      "title": "Tempo Bpm",
      "type": "number"
    },
    "beats": {
      "items": {
        "type": "number"
      },
      "title": "Beats",
      "type": "array"
    },
    "bars": {
      "description": "Start time of each bar, in seconds.",
      "items": {
        "type": "number"
      },
      "title": "Bars",
      "type": "array"
    },
    "bar_intensity": {
      "description": "Loudness of each bar, scaled 0-1.",
      "items": {
        "type": "number"
      },
      "title": "Bar Intensity",
      "type": "array"
    },
    "vocal_windows": {
      "items": {
        "$ref": "#/$defs/TimeSpan"
      },
      "title": "Vocal Windows",
      "type": "array"
    },
    "vocal_turns": {
      "description": "Diarized vocal turns grouped by acoustic voice pitch and timbre.",
      "items": {
        "$ref": "#/$defs/VocalTurn"
      },
      "title": "Vocal Turns",
      "type": "array"
    },
    "lyric_lines": {
      "items": {
        "$ref": "#/$defs/LyricLine"
      },
      "title": "Lyric Lines",
      "type": "array"
    },
    "chapters": {
      "description": "Per-track segments measured in long-form mix mode.",
      "items": {
        "$ref": "#/$defs/AnalyzedChapter"
      },
      "title": "Chapters",
      "type": "array"
    }
  },
  "required": [
    "duration",
    "tempo_bpm",
    "beats",
    "bars",
    "bar_intensity",
    "vocal_windows"
  ],
  "title": "Analysis",
  "type": "object"
}
