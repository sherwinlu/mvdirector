{
  "$defs": {
    "AlignmentWarning": {
      "additionalProperties": false,
      "description": "Pre-spend alignment anomaly surfaced during audio/lyric verification.\n\nInspired by ``JavaDerek/music-video-pipeline`` (``alignment_quality.py``, ``join_witness.py``).",
      "properties": {
        "kind": {
          "enum": [
            "unvoiced_lyric",
            "high_consonant_bleed",
            "unaligned_vocal_window",
            "boundary_word_cut"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "AlignmentWarning",
      "type": "object"
    },
    "AnalyzedChapter": {
      "additionalProperties": false,
      "description": "Per-track or fixed-interval segment measured during long-form mix audio analysis.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "bpm": {
          "exclusiveMinimum": 0.0,
          "title": "Bpm",
          "type": "number"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "downbeat_offset": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Downbeat Offset",
          "type": "number"
        },
        "energy": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Energy",
          "type": "number"
        },
        "mood_tags": {
          "items": {
            "type": "string"
          },
          "title": "Mood Tags",
          "type": "array"
        },
        "genre_tags": {
          "items": {
            "type": "string"
          },
          "title": "Genre Tags",
          "type": "array"
        },
        "theme_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theme Prompt"
        },
        "clip_prompts": {
          "items": {
            "type": "string"
          },
          "title": "Clip Prompts",
          "type": "array"
        },
        "lyrics": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lyrics"
        },
        "cues": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioCues"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structural energy landmarks (lift, peaks, breakdown) within this chapter."
        }
      },
      "required": [
        "id",
        "index",
        "start",
        "end",
        "title",
        "bpm"
      ],
      "title": "AnalyzedChapter",
      "type": "object"
    },
    "AudioCues": {
      "additionalProperties": false,
      "description": "Structural energy landmarks detected from audio (no lyrics required).\n\nCredits & Attribution:\n    Composite energy/onset/brightness landmark detection ported from\n    ``sherwinlu/weaveshift`` (``weaveshift/cues.py``).",
      "properties": {
        "first_lift": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First sustained energy lift above intro baseline, in seconds.",
          "title": "First Lift"
        },
        "main_peak": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary energy/onset/brightness peak (drop or main chorus), in seconds.",
          "title": "Main Peak"
        },
        "second_peak": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Secondary structural peak separated from main_peak, in seconds.",
          "title": "Second Peak"
        },
        "breakdown": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lowest-energy mid-track valley/breakdown candidate, in seconds.",
          "title": "Breakdown"
        },
        "confidence": {
          "default": "low",
          "description": "Peak prominence confidence ('low', 'medium', or 'high').",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "title": "AudioCues",
      "type": "object"
    },
    "BroadcastAudioQA": {
      "additionalProperties": false,
      "description": "Broadcast loudness (ITU-R BS.1770-4 LUFS), 4x True Peak, and splice-click diagnostics.",
      "properties": {
        "integrated_lufs": {
          "title": "Integrated Lufs",
          "type": "number"
        },
        "true_peak_dbtp": {
          "title": "True Peak Dbtp",
          "type": "number"
        },
        "splice_clicks": {
          "items": {
            "type": "number"
          },
          "title": "Splice Clicks",
          "type": "array"
        }
      },
      "required": [
        "integrated_lufs",
        "true_peak_dbtp"
      ],
      "title": "BroadcastAudioQA",
      "type": "object"
    },
    "LyricLine": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "timing_source": {
          "default": "none",
          "enum": [
            "aligned",
            "estimated",
            "none"
          ],
          "title": "Timing Source",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "LyricLine",
      "type": "object"
    },
    "MusicalFeatures": {
      "additionalProperties": false,
      "description": "Acoustic and musical characteristics measured directly from the audio mix.",
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated musical key and mode (e.g. 'A minor', 'C major'), or null if atonal.",
          "title": "Key"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "major",
                "minor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated harmonic mode ('major' or 'minor'), or null if unclear.",
          "title": "Mode"
        },
        "camelot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Camelot wheel key notation (e.g. '8A', '8B'), or null if unclear.",
          "title": "Camelot"
        },
        "brightness": {
          "default": "balanced",
          "description": "Timbral brightness inferred from median spectral centroid.",
          "enum": [
            "dark",
            "warm",
            "balanced",
            "bright"
          ],
          "title": "Brightness",
          "type": "string"
        },
        "spectral_centroid_hz": {
          "default": 0.0,
          "description": "Median spectral centroid in Hz across active frames.",
          "minimum": 0.0,
          "title": "Spectral Centroid Hz",
          "type": "number"
        },
        "percussiveness": {
          "default": "balanced",
          "description": "Harmonic-vs-percussive texture balance.",
          "enum": [
            "ambient",
            "melodic",
            "balanced",
            "rhythmic",
            "percussive"
          ],
          "title": "Percussiveness",
          "type": "string"
        },
        "percussive_ratio": {
          "default": 0.0,
          "description": "Share (0-1) of signal energy in the percussive component.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Percussive Ratio",
          "type": "number"
        },
        "dynamic_range": {
          "default": "moderate",
          "description": "Loudness contrast across the track.",
          "enum": [
            "flat",
            "moderate",
            "dynamic",
            "cinematic"
          ],
          "title": "Dynamic Range",
          "type": "string"
        },
        "dynamic_range_db": {
          "default": 0.0,
          "description": "95th-minus-15th percentile RMS loudness spread in dB across active frames.",
          "minimum": 0.0,
          "title": "Dynamic Range Db",
          "type": "number"
        },
        "onset_density": {
          "default": 0.0,
          "description": "Average musical onsets per second.",
          "minimum": 0.0,
          "title": "Onset Density",
          "type": "number"
        },
        "summary": {
          "default": "",
          "description": "Compact human-readable musical character summary for planning prompts.",
          "title": "Summary",
          "type": "string"
        }
      },
      "title": "MusicalFeatures",
      "type": "object"
    },
    "StemArrangement": {
      "additionalProperties": false,
      "description": "Multi-stem instrumentation and arrangement analysis derived from extracted song stems.",
      "properties": {
        "stems": {
          "description": "Catalog of analyzed stems with roles and active time spans.",
          "items": {
            "$ref": "#/$defs/StemTrackInfo"
          },
          "title": "Stems",
          "type": "array"
        },
        "backing_vocal_windows": {
          "description": "Time spans where backing vocals or harmonies are active.",
          "items": {
            "$ref": "#/$defs/TimeSpan"
          },
          "title": "Backing Vocal Windows",
          "type": "array"
        },
        "rhythm_drops": {
          "description": "Bar timestamps (seconds) where drums/bass drop out or slam back in.",
          "items": {
            "type": "number"
          },
          "title": "Rhythm Drops",
          "type": "array"
        },
        "summary": {
          "default": "",
          "description": "Compact human-readable instrumentation and arrangement summary for planning.",
          "title": "Summary",
          "type": "string"
        }
      },
      "title": "StemArrangement",
      "type": "object"
    },
    "StemTrackInfo": {
      "additionalProperties": false,
      "description": "Measured metadata and activity spans for one ingested instrument or vocal stem.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable stem label (e.g. 'Lead Vocals', 'Woodwinds').",
          "title": "Name",
          "type": "string"
        },
        "role": {
          "description": "Canonical musical role inferred from the stem filename.",
          "enum": [
            "lead_vocals",
            "backing_vocals",
            "vocals",
            "drums",
            "percussion",
            "bass",
            "guitar",
            "keys",
            "strings",
            "synth",
            "brass",
            "woodwinds",
            "instrumental",
            "fx",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "path": {
          "description": "Project-relative path to the normalized stem WAV file.",
          "title": "Path",
          "type": "string"
        },
        "active_fraction": {
          "default": 0.0,
          "description": "Share (0-1) of the song duration where this stem is audibly active.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Active Fraction",
          "type": "number"
        },
        "energy_share": {
          "default": 0.0,
          "description": "Relative RMS energy share (0-1) compared to all analyzed stems.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Energy Share",
          "type": "number"
        },
        "active_spans": {
          "description": "Time spans in seconds where this stem is audibly active.",
          "items": {
            "$ref": "#/$defs/TimeSpan"
          },
          "title": "Active Spans",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "path"
      ],
      "title": "StemTrackInfo",
      "type": "object"
    },
    "TimeSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeSpan",
      "type": "object"
    },
    "TrackProfile": {
      "additionalProperties": false,
      "description": "Detected musical, vocal, and linguistic characteristics used to auto-tune parameters.",
      "properties": {
        "languages": {
          "description": "Detected ISO-639-1/639-2 language codes (e.g. ['en'], ['fr', 'en'], ['zh']).",
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "multilingual": {
          "default": false,
          "description": "True when lyrics or style cues span more than one language.",
          "title": "Multilingual",
          "type": "boolean"
        },
        "vocal_mode": {
          "default": "solo",
          "description": "Primary vocal arrangement ('solo', 'duet', 'group', or 'instrumental').",
          "enum": [
            "solo",
            "duet",
            "group",
            "instrumental"
          ],
          "title": "Vocal Mode",
          "type": "string"
        },
        "rap_or_fast_vocal": {
          "default": false,
          "description": "True when style cues or measured syllable rate indicate rap or rapid phrasing.",
          "title": "Rap Or Fast Vocal",
          "type": "boolean"
        },
        "drop_or_chop_heavy": {
          "default": false,
          "description": "True when style/section cues or peak non-lyric bars indicate drops/vocal chops.",
          "title": "Drop Or Chop Heavy",
          "type": "boolean"
        },
        "extreme_vocals": {
          "default": false,
          "description": "True when cues indicate screamed, whispered, or heavily processed vocals.",
          "title": "Extreme Vocals",
          "type": "boolean"
        },
        "non_4_4_or_free_time": {
          "default": false,
          "description": "True when cues indicate 3/4, 6/8, odd meter, or rubato/beatless timing.",
          "title": "Non 4 4 Or Free Time",
          "type": "boolean"
        },
        "beats_per_bar_hint": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Meter grouping inferred from style cues when explicitly non-4/4 (e.g. 3).",
          "title": "Beats Per Bar Hint"
        },
        "syllables_per_second": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Measured sung syllable/token rate across aligned or active vocal spans.",
          "title": "Syllables Per Second"
        },
        "intensity_contrast": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "90th-minus-20th percentile of bar_intensity (0-1).",
          "title": "Intensity Contrast"
        },
        "reasons": {
          "description": "Human-readable explanations for detected track characteristics.",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "title": "TrackProfile",
      "type": "object"
    },
    "VocalTurn": {
      "additionalProperties": false,
      "description": "A contiguous vocal phrase attributed to one acoustic voice cluster or simultaneous duet.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "voice": {
          "description": "Acoustic voice id ('voice_1', 'voice_2', ordered low-to-high pitch, or 'both' when multiple voices sing simultaneously).",
          "title": "Voice",
          "type": "string"
        },
        "median_f0_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Median fundamental frequency in Hz across voiced frames.",
          "title": "Median F0 Hz"
        }
      },
      "required": [
        "start",
        "end",
        "voice"
      ],
      "title": "VocalTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "duration": {
      "title": "Duration",
      "type": "number"
    },
    "tempo_bpm": {
      "title": "Tempo Bpm",
      "type": "number"
    },
    "beats": {
      "items": {
        "type": "number"
      },
      "title": "Beats",
      "type": "array"
    },
    "bars": {
      "description": "Start time of each bar, in seconds.",
      "items": {
        "type": "number"
      },
      "title": "Bars",
      "type": "array"
    },
    "bar_intensity": {
      "description": "Loudness of each bar, scaled 0-1.",
      "items": {
        "type": "number"
      },
      "title": "Bar Intensity",
      "type": "array"
    },
    "vocal_windows": {
      "items": {
        "$ref": "#/$defs/TimeSpan"
      },
      "title": "Vocal Windows",
      "type": "array"
    },
    "vocal_turns": {
      "description": "Diarized vocal turns grouped by acoustic voice pitch and timbre.",
      "items": {
        "$ref": "#/$defs/VocalTurn"
      },
      "title": "Vocal Turns",
      "type": "array"
    },
    "lyric_lines": {
      "items": {
        "$ref": "#/$defs/LyricLine"
      },
      "title": "Lyric Lines",
      "type": "array"
    },
    "alignment_warnings": {
      "description": "Pre-spend acoustic/boundary lyric alignment diagnostics.",
      "items": {
        "$ref": "#/$defs/AlignmentWarning"
      },
      "title": "Alignment Warnings",
      "type": "array"
    },
    "broadcast_qa": {
      "anyOf": [
        {
          "$ref": "#/$defs/BroadcastAudioQA"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Broadcast loudness, 4x true-peak headroom, and splice-click diagnostics."
    },
    "track_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrackProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Detected musical/vocal/language profile used for automatic parameter tuning."
    },
    "musical_features": {
      "anyOf": [
        {
          "$ref": "#/$defs/MusicalFeatures"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Acoustic musical qualities (key, mode, brightness, percussiveness, dynamics)."
    },
    "cues": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudioCues"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Structural energy landmarks (first lift, peaks, breakdown) in seconds."
    },
    "stems": {
      "anyOf": [
        {
          "$ref": "#/$defs/StemArrangement"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional multi-stem instrumentation and arrangement analysis."
    },
    "chapters": {
      "description": "Per-track segments measured in long-form mix mode.",
      "items": {
        "$ref": "#/$defs/AnalyzedChapter"
      },
      "title": "Chapters",
      "type": "array"
    }
  },
  "required": [
    "duration",
    "tempo_bpm",
    "beats",
    "bars",
    "bar_intensity",
    "vocal_windows"
  ],
  "title": "Analysis",
  "type": "object"
}
