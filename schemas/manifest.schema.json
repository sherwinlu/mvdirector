{
  "$defs": {
    "AssetState": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/AssetStatus",
          "default": "pending"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/Attempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "attempts_allowed": {
          "default": 0,
          "title": "Attempts Allowed",
          "type": "integer"
        },
        "selected_attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Attempt"
        },
        "prompt_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rewritten shot prompt, set by the retry policy.",
          "title": "Prompt Override"
        },
        "param_overrides": {
          "additionalProperties": true,
          "title": "Param Overrides",
          "type": "object"
        },
        "director_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reviewer feedback to apply on the next attempt.",
          "title": "Director Note"
        },
        "accepted_by_reviewer": {
          "default": false,
          "description": "A person accepted an attempt that did not pass QC.",
          "title": "Accepted By Reviewer",
          "type": "boolean"
        },
        "upscaled_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional upscaled output derived from the selected attempt.",
          "title": "Upscaled Path"
        },
        "upscaled_from_attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Attempt number that upscaled_path was generated from.",
          "title": "Upscaled From Attempt"
        }
      },
      "title": "AssetState",
      "type": "object"
    },
    "AssetStatus": {
      "enum": [
        "pending",
        "passed",
        "exhausted"
      ],
      "title": "AssetStatus",
      "type": "string"
    },
    "Attempt": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "strategy": {
          "$ref": "#/$defs/RetryStrategy"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "qc": {
          "anyOf": [
            {
              "$ref": "#/$defs/QCReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sync_delay_seconds": {
          "default": 0.0,
          "description": "Measured audio-video lip-sync offset applied to clip in-point during assembly (inspired by VisualFrisson/ComfyUI-OneShotMV).",
          "title": "Sync Delay Seconds",
          "type": "number"
        },
        "regressed": {
          "default": false,
          "description": "True when an in-place repair did not strictly improve on the previous attempt and should be excluded from best_attempt selection.",
          "title": "Regressed",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "number",
        "strategy",
        "seed",
        "prompt"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "AudioSlice": {
      "additionalProperties": false,
      "description": "Audio handed to the video model. Includes handles trimmed off at assembly.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "head_handle": {
          "description": "Seconds between slice start and shot start.",
          "title": "Head Handle",
          "type": "number"
        },
        "mute_spans": {
          "description": "Song-timeline spans silenced inside this slice so another singer's voice does not bleed into lip-sync.",
          "items": {
            "$ref": "#/$defs/TimeSpan"
          },
          "title": "Mute Spans",
          "type": "array"
        }
      },
      "required": [
        "path",
        "start",
        "end",
        "head_handle"
      ],
      "title": "AudioSlice",
      "type": "object"
    },
    "Character": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "",
          "description": "Display name or role of the character.",
          "title": "Name",
          "type": "string"
        },
        "appearance": {
          "default": "",
          "description": "Permanent look: face, hair, makeup, build, marks. No clothing.",
          "title": "Appearance",
          "type": "string"
        },
        "invariants": {
          "default": "",
          "description": "Details written into every still of this character and kept across wardrobe changes (accessories, hair). Nothing a costume change would alter.",
          "title": "Invariants",
          "type": "string"
        },
        "parent_character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional character id whose locked base sheet this base sheet edits.",
          "title": "Parent Character"
        },
        "wardrobe": {
          "description": "Costume states in the order they appear in the song.",
          "items": {
            "$ref": "#/$defs/WardrobeState"
          },
          "title": "Wardrobe",
          "type": "array"
        },
        "references": {
          "additionalProperties": {
            "$ref": "#/$defs/ReferenceSet"
          },
          "description": "Locked reference sheets, keyed by wardrobe state id ('base' if none).",
          "title": "References",
          "type": "object"
        }
      },
      "title": "Character",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "hard": {
          "default": false,
          "description": "A failed hard check rejects the asset whatever its score.",
          "title": "Hard",
          "type": "boolean"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-1, higher is better.",
          "title": "Score"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "fix_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Advice fed into the next attempt's prompt.",
          "title": "Fix Hint"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "ContinuityMode": {
      "description": "How a shot connects visually to the preceding shot.\n\nInspired by ``afj176/open-cinema-studio`` (``cut`` / ``reframe`` / ``continue``).",
      "enum": [
        "cut",
        "reframe",
        "continue"
      ],
      "title": "ContinuityMode",
      "type": "string"
    },
    "Framing": {
      "enum": [
        "close_up",
        "medium_close",
        "medium",
        "wide"
      ],
      "title": "Framing",
      "type": "string"
    },
    "MixChapter": {
      "additionalProperties": false,
      "description": "One track segment in a long-form mix, holding its visual theme and loop shot ids.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "bpm": {
          "exclusiveMinimum": 0.0,
          "title": "Bpm",
          "type": "number"
        },
        "downbeat_offset": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Downbeat Offset",
          "type": "number"
        },
        "energy": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Energy",
          "type": "number"
        },
        "mood_tags": {
          "items": {
            "type": "string"
          },
          "title": "Mood Tags",
          "type": "array"
        },
        "genre_tags": {
          "items": {
            "type": "string"
          },
          "title": "Genre Tags",
          "type": "array"
        },
        "environment": {
          "default": "",
          "title": "Environment",
          "type": "string"
        },
        "palette": {
          "default": "",
          "title": "Palette",
          "type": "string"
        },
        "lighting": {
          "default": "",
          "title": "Lighting",
          "type": "string"
        },
        "motion_style": {
          "default": "",
          "title": "Motion Style",
          "type": "string"
        },
        "shot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Shot Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "index",
        "start",
        "end",
        "title",
        "bpm"
      ],
      "title": "MixChapter",
      "type": "object"
    },
    "ProjectMode": {
      "enum": [
        "standard",
        "mix"
      ],
      "title": "ProjectMode",
      "type": "string"
    },
    "PropDesign": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Physical design, materials, scale in cm, and negative exclusions.",
          "title": "Description",
          "type": "string"
        },
        "sections": {
          "description": "Parts of the song where this prop appears.",
          "items": {
            "type": "string"
          },
          "title": "Sections",
          "type": "array"
        },
        "plate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Locked two-angle reference image of the prop.",
          "title": "Plate"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "PropDesign",
      "type": "object"
    },
    "QCReport": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "passed",
        "score"
      ],
      "title": "QCReport",
      "type": "object"
    },
    "ReferenceSet": {
      "additionalProperties": false,
      "description": "A locked character reference sheet and the panels cut from it.",
      "properties": {
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The locked reference sheet image.",
          "title": "Sheet"
        },
        "panels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Panel crops cut from the sheet (front, profile, three_quarter, face, back).",
          "title": "Panels",
          "type": "object"
        },
        "video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional locked silent turnaround and expression reference video.",
          "title": "Video"
        }
      },
      "title": "ReferenceSet",
      "type": "object"
    },
    "RetryStrategy": {
      "enum": [
        "initial",
        "handoff",
        "new_seed",
        "rewrite_prompt",
        "repair_still",
        "adjust_params"
      ],
      "title": "RetryStrategy",
      "type": "string"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ReviewReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "ReviewDecision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewReason": {
      "enum": [
        "exhausted",
        "retried",
        "near_threshold",
        "sampled",
        "escalated",
        "lipsync",
        "fallback"
      ],
      "title": "ReviewReason",
      "type": "string"
    },
    "SectionBeat": {
      "additionalProperties": false,
      "description": "Emotional and narrative direction for one song section.",
      "properties": {
        "section": {
          "description": "Song section name matching the lyrics tags (e.g. 'Verse 1').",
          "title": "Section",
          "type": "string"
        },
        "emotion": {
          "default": "",
          "description": "Emotional state or tension in this section.",
          "title": "Emotion",
          "type": "string"
        },
        "visual_beat": {
          "default": "",
          "description": "What happens visually or narratively here to express the lyrics and music.",
          "title": "Visual Beat",
          "type": "string"
        },
        "camera_energy": {
          "default": "",
          "description": "How camera language, pacing, and performance energy should feel in this section.",
          "title": "Camera Energy",
          "type": "string"
        }
      },
      "required": [
        "section"
      ],
      "title": "SectionBeat",
      "type": "object"
    },
    "SetDesign": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sections": {
          "description": "Parts of the song this set is used for.",
          "items": {
            "type": "string"
          },
          "title": "Sections",
          "type": "array"
        },
        "description": {
          "default": "",
          "description": "What the set looks like.",
          "title": "Description",
          "type": "string"
        },
        "movement": {
          "default": "",
          "description": "How the singer moves and the camera works here.",
          "title": "Movement",
          "type": "string"
        },
        "parent_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional set name whose locked plate this set's plate is edited from.",
          "title": "Parent Set"
        },
        "plate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Locked image of the empty location, used as a second reference.",
          "title": "Plate"
        }
      },
      "required": [
        "name"
      ],
      "title": "SetDesign",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/ShotType"
        },
        "framing": {
          "$ref": "#/$defs/Framing",
          "default": "medium"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Song section this shot falls in, from the lyric tags.",
          "title": "Section"
        },
        "chapter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent chapter id when planned in long-form mix mode.",
          "title": "Chapter Id"
        },
        "setting": {
          "default": "",
          "description": "Name of a set in the visual bible.",
          "title": "Setting",
          "type": "string"
        },
        "character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary character id on camera / singing in this shot.",
          "title": "Character"
        },
        "characters": {
          "description": "All character ids visible in this shot (for duets, two-shots, or bands).",
          "items": {
            "type": "string"
          },
          "title": "Characters",
          "type": "array"
        },
        "singers": {
          "description": "Character ids actively singing in this shot (1 for solo A or B, 2+ when singing together in unison/harmony; empty when not singing).",
          "items": {
            "type": "string"
          },
          "title": "Singers",
          "type": "array"
        },
        "wardrobe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wardrobe state id worn in the shot's first frame.",
          "title": "Wardrobe"
        },
        "character_wardrobes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Wardrobe state id per visible character in multi-character shots.",
          "title": "Character Wardrobes",
          "type": "object"
        },
        "lyrics": {
          "default": "",
          "title": "Lyrics",
          "type": "string"
        },
        "fallback_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the shot was converted from this type after it could not be made."
        },
        "intensity": {
          "default": 0.5,
          "title": "Intensity",
          "type": "number"
        },
        "still_prompt": {
          "default": "",
          "title": "Still Prompt",
          "type": "string"
        },
        "motion_prompt": {
          "default": "",
          "title": "Motion Prompt",
          "type": "string"
        },
        "allow_cuts": {
          "default": false,
          "description": "Opt-in multi-angle montage mode: allows internal cuts inside this clip.",
          "title": "Allow Cuts",
          "type": "boolean"
        },
        "props": {
          "description": "Recurring hero prop ids or names visible in this shot.",
          "items": {
            "type": "string"
          },
          "title": "Props",
          "type": "array"
        },
        "previz_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional 3D blocking / previz video path guiding camera motion and staging.",
          "title": "Previz Video"
        },
        "previz_depth_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional linear view-space depth pass rendered alongside previz_video (white=near, black=far; inspired by heroesjouney/aimoviestudiov2).",
          "title": "Previz Depth Video"
        },
        "previz_mapping": {
          "default": "",
          "description": "Stand-in mapping from blocking shapes in previz_video to real subjects/props.",
          "title": "Previz Mapping",
          "type": "string"
        },
        "continuity": {
          "$ref": "#/$defs/ContinuityMode",
          "default": "cut",
          "description": "Shot continuity link to the preceding shot ('cut', 'reframe', or 'continue')."
        },
        "end_frame_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional target end-frame image path for first/last-frame (FLF2V) workflows.",
          "title": "End Frame Path"
        },
        "camera_path_zoom": {
          "anyOf": [
            {
              "exclusiveMinimum": 1.0,
              "maximum": 3.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Lanczos zoom factor for an auto-generated end-frame camera-path guide on empty wide shots (inspired by afj176/open-cinema-studio).",
          "title": "Camera Path Zoom"
        },
        "sfx_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
